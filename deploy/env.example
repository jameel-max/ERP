# ============================================================
# انسخ هذا الملف إلى ".env" في جذر المشروع ثم عدّل القيم.
# (يُقرأ تلقائياً عند تشغيل Django - بدون مكتبات إضافية)
# لا ترفع هذا الملف إلى أي مستودع عام لأنه يحتوي أسراراً.
# ============================================================

# مفتاح سري طويل وعشوائي (إلزامي في الإنتاج). ولّده بأمر:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=ضع-مفتاحاً-عشوائياً-طويلاً-هنا

# للإنتاج اجعله دائماً False
DJANGO_DEBUG=False

# النطاقات/العناوين المسموحة مفصولة بفواصل
DJANGO_ALLOWED_HOSTS=erp.example.com,127.0.0.1,localhost

# أصول موثوقة للـ CSRF عند العمل خلف HTTPS
DJANGO_CSRF_TRUSTED_ORIGINS=https://erp.example.com

# ---- قاعدة البيانات ----
# الخيار الأسهل: رابط واحد من لوحة تحكم Neon (console.neon.tech)
# انسخ "Pooled connection" من صفحة المشروع > Connect
# DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-xxxx.aws.neon.tech/neondb?sslmode=require
#
# (إن لم تُضبط DATABASE_URL تُستخدم SQLite افتراضياً للتطوير المحلي)

# ---- أو بمتفرقات (PostgreSQL عادي/محلّي) ----
# DB_ENGINE=postgresql
# DB_NAME=royal_fruit
# DB_USER=royal
# DB_PASSWORD=********
# DB_HOST=localhost
# DB_PORT=5432

# ---- خادم Waitress ----
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_THREADS=8

# ---- أمان إضافي في الإنتاج (اختياري) ----
# SECURE_SSL_REDIRECT=False  # أوقف التوجيه إلى HTTPS لو التطبيق يرى HTTP داخل الشبكة خلف الوكيل
# SECURE_HSTS_SECONDS=31536000
